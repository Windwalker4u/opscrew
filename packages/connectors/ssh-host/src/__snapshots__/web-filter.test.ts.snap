DROP_IN='/etc/systemd/system/docker.service.d/opscrew-web-filter.conf'
SERVICE='opscrew-web-filter.service'
CHAIN='OPSCREW-WEB'
SCRIPT_B64=''
UNIT_B64=''
DROPIN_B64=''
SCRIPT_SHA256='7041f46b3e89fd34e397c4bfda5053ef8c22c52a80f69a6919c0cc96405a962a'
UNIT_SHA256='5ba0c4e7fc47da79c43dd085a0191a240f49e8b3499c4ca253bad677b4893782'
DROPIN_SHA256='97c2a952b4f120ec2d2868592b8fc4fc5e02ce2bc7109fff45f5ce1d4df9ef0a'
IPV4='103.21.244.0/22 173.245.48.0/20'
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
leading_ok() {
  top=$(iptables -w -S DOCKER-USER 2>/dev/null | grep '^-A ' | head -n 3) || return 1
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    printf '%s\\n' "$top" | grep -- "-p $proto " | grep -- "--ctorigdstport $port " | grep -q -- " -j OPSCREW-WEB\\$" || return 1
  done
}
chain_ok() {
  iptables -w -n -L OPSCREW-WEB >/dev/null 2>&1 || return 1
  rules=$(iptables -w -S OPSCREW-WEB | grep -c '^-A ') || return 1
  n=0
  for net in $1; do
    n=$((n + 1))
    iptables -w -C OPSCREW-WEB -s "$net" -j RETURN 2>/dev/null || return 1
  done
  [ "$rules" -eq $((n + 1)) ] || return 1
  [ "$(iptables -w -S OPSCREW-WEB | grep '^-A ' | tail -n 1)" = "-A OPSCREW-WEB -j DROP" ]
}
file_is() { [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d ' ' -f 1)" = "$2" ]; }
# Removes OpsCrew's jumps from DOCKER-USER and its chain.
remove_rules() {
  command -v iptables >/dev/null 2>&1 || return 0
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    while iptables -w -C DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN" 2>/dev/null; do
      iptables -w -D DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN"
    done
  done
  if iptables -w -n -L "$CHAIN" >/dev/null 2>&1; then
    iptables -w -F "$CHAIN"
    iptables -w -X "$CHAIN" || fail "Another rule still jumps to OpsCrew's chain $CHAIN; remove that rule, then run the command again."
  fi
}
verify_state() {
  file_is "$SCRIPT" "$SCRIPT_SHA256" || return 1
  file_is "$UNIT_FILE" "$UNIT_SHA256" || return 1
  file_is "$DROP_IN" "$DROPIN_SHA256" || return 1
  [ "$(systemctl is-enabled "$SERVICE" 2>/dev/null)" = enabled ] || return 1
  systemctl is-active --quiet "$SERVICE" || return 1
  chain_ok "$IPV4" || return 1
  leading_ok || return 1
}
if [ -e "$SCRIPT" ]; then echo prev.installed=true; else echo prev.installed=false; fi
if verify_state >/dev/null 2>&1; then echo state=in-place; else echo state=change; fi
",
  "doing": "setting up the web filter for Cloudflare's addresses",
  "timeoutMs": 120000,
  "verify": "# opscrew-host: web-filter.verify
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
SCRIPT='/usr/local/sbin/opscrew-web-filter'
UNIT_FILE='/etc/systemd/system/opscrew-web-filter.service'
DROP_IN='/etc/systemd/system/docker.service.d/opscrew-web-filter.conf'
SERVICE='opscrew-web-filter.service'
CHAIN='OPSCREW-WEB'
SCRIPT_B64=''
UNIT_B64=''
DROPIN_B64=''
SCRIPT_SHA256='7041f46b3e89fd34e397c4bfda5053ef8c22c52a80f69a6919c0cc96405a962a'
UNIT_SHA256='5ba0c4e7fc47da79c43dd085a0191a240f49e8b3499c4ca253bad677b4893782'
DROPIN_SHA256='97c2a952b4f120ec2d2868592b8fc4fc5e02ce2bc7109fff45f5ce1d4df9ef0a'
IPV4='103.21.244.0/22 173.245.48.0/20'
VERIFY_FAILED='OpsCrew'\\''s web filter is not in effect.'
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
leading_ok() {
  top=$(iptables -w -S DOCKER-USER 2>/dev/null | grep '^-A ' | head -n 3) || return 1
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    printf '%s\\n' "$top" | grep -- "-p $proto " | grep -- "--ctorigdstport $port " | grep -q -- " -j OPSCREW-WEB\\$" || return 1
  done
}
chain_ok() {
  iptables -w -n -L OPSCREW-WEB >/dev/null 2>&1 || return 1
  rules=$(iptables -w -S OPSCREW-WEB | grep -c '^-A ') || return 1
  n=0
  for net in $1; do
    n=$((n + 1))
    iptables -w -C OPSCREW-WEB -s "$net" -j RETURN 2>/dev/null || return 1
  done
  [ "$rules" -eq $((n + 1)) ] || return 1
  [ "$(iptables -w -S OPSCREW-WEB | grep '^-A ' | tail -n 1)" = "-A OPSCREW-WEB -j DROP" ]
}
file_is() { [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d ' ' -f 1)" = "$2" ]; }
# Removes OpsCrew's jumps from DOCKER-USER and its chain.
remove_rules() {
  command -v iptables >/dev/null 2>&1 || return 0
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    while iptables -w -C DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN" 2>/dev/null; do
      iptables -w -D DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN"
    done
  done
  if iptables -w -n -L "$CHAIN" >/dev/null 2>&1; then
    iptables -w -F "$CHAIN"
    iptables -w -X "$CHAIN" || fail "Another rule still jumps to OpsCrew's chain $CHAIN; remove that rule, then run the command again."
  fi
}
verify_state() {
  file_is "$SCRIPT" "$SCRIPT_SHA256" || return 1
  file_is "$UNIT_FILE" "$UNIT_SHA256" || return 1
  file_is "$DROP_IN" "$DROPIN_SHA256" || return 1
  [ "$(systemctl is-enabled "$SERVICE" 2>/dev/null)" = enabled ] || return 1
  systemctl is-active --quiet "$SERVICE" || return 1
  chain_ok "$IPV4" || return 1
  leading_ok || return 1
}
verify_state || fail "$VERIFY_FAILED" 5
",
}
`;

exports[`the web filter's renders > the removal's scripts match their snapshot 1`] = `
{
  "apply": "# opscrew-host: web-filter.remove.apply
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
SCRIPT='/usr/local/sbin/opscrew-web-filter'
UNIT_FILE='/etc/systemd/system/opscrew-web-filter.service'
DROP_IN='/etc/systemd/system/docker.service.d/opscrew-web-filter.conf'
SERVICE='opscrew-web-filter.service'
CHAIN='OPSCREW-WEB'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
leading_ok() {
  top=$(iptables -w -S DOCKER-USER 2>/dev/null | grep '^-A ' | head -n 3) || return 1
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    printf '%s\\n' "$top" | grep -- "-p $proto " | grep -- "--ctorigdstport $port " | grep -q -- " -j OPSCREW-WEB\\$" || return 1
  done
}
chain_ok() {
  iptables -w -n -L OPSCREW-WEB >/dev/null 2>&1 || return 1
  rules=$(iptables -w -S OPSCREW-WEB | grep -c '^-A ') || return 1
  n=0
  for net in $1; do
    n=$((n + 1))
    iptables -w -C OPSCREW-WEB -s "$net" -j RETURN 2>/dev/null || return 1
  done
  [ "$rules" -eq $((n + 1)) ] || return 1
  [ "$(iptables -w -S OPSCREW-WEB | grep '^-A ' | tail -n 1)" = "-A OPSCREW-WEB -j DROP" ]
}
file_is() { [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d ' ' -f 1)" = "$2" ]; }
# Removes OpsCrew's jumps from DOCKER-USER and its chain.
remove_rules() {
  command -v iptables >/dev/null 2>&1 || return 0
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    while iptables -w -C DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN" 2>/dev/null; do
      iptables -w -D DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN"
    done
  done
  if iptables -w -n -L "$CHAIN" >/dev/null 2>&1; then
    iptables -w -F "$CHAIN"
    iptables -w -X "$CHAIN" || fail "Another rule still jumps to OpsCrew's chain $CHAIN; remove that rule, then run the command again."
  fi
}
rm -f "$DROP_IN"
systemctl daemon-reload
systemctl disable "$SERVICE" >/dev/null 2>&1 || true
systemctl stop "$SERVICE" >/dev/null 2>&1 || true
remove_rules
if command -v nft >/dev/null 2>&1 && nft list table inet opscrew-web >/dev/null 2>&1; then
  nft delete table inet opscrew-web
fi
rm -f "$UNIT_FILE" "$SCRIPT"
systemctl daemon-reload
",
  "check": "# opscrew-host: web-filter.remove.check
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
SCRIPT='/usr/local/sbin/opscrew-web-filter'
UNIT_FILE='/etc/systemd/system/opscrew-web-filter.service'
DROP_IN='/etc/systemd/system/docker.service.d/opscrew-web-filter.conf'
SERVICE='opscrew-web-filter.service'
CHAIN='OPSCREW-WEB'
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
leading_ok() {
  top=$(iptables -w -S DOCKER-USER 2>/dev/null | grep '^-A ' | head -n 3) || return 1
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    printf '%s\\n' "$top" | grep -- "-p $proto " | grep -- "--ctorigdstport $port " | grep -q -- " -j OPSCREW-WEB\\$" || return 1
  done
}
chain_ok() {
  iptables -w -n -L OPSCREW-WEB >/dev/null 2>&1 || return 1
  rules=$(iptables -w -S OPSCREW-WEB | grep -c '^-A ') || return 1
  n=0
  for net in $1; do
    n=$((n + 1))
    iptables -w -C OPSCREW-WEB -s "$net" -j RETURN 2>/dev/null || return 1
  done
  [ "$rules" -eq $((n + 1)) ] || return 1
  [ "$(iptables -w -S OPSCREW-WEB | grep '^-A ' | tail -n 1)" = "-A OPSCREW-WEB -j DROP" ]
}
file_is() { [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d ' ' -f 1)" = "$2" ]; }
# Removes OpsCrew's jumps from DOCKER-USER and its chain.
remove_rules() {
  command -v iptables >/dev/null 2>&1 || return 0
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    while iptables -w -C DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN" 2>/dev/null; do
      iptables -w -D DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN"
    done
  done
  if iptables -w -n -L "$CHAIN" >/dev/null 2>&1; then
    iptables -w -F "$CHAIN"
    iptables -w -X "$CHAIN" || fail "Another rule still jumps to OpsCrew's chain $CHAIN; remove that rule, then run the command again."
  fi
}
verify_state() {
  [ ! -e "$SCRIPT" ] && [ ! -e "$UNIT_FILE" ] && [ ! -e "$DROP_IN" ] || return 1
  if command -v iptables >/dev/null 2>&1 && iptables -w -n -L "$CHAIN" >/dev/null 2>&1; then
    return 1
  fi
  if command -v nft >/dev/null 2>&1 && nft list table inet opscrew-web >/dev/null 2>&1; then
    return 1
  fi
}

if verify_state >/dev/null 2>&1; then echo state=in-place; else echo state=change; fi
