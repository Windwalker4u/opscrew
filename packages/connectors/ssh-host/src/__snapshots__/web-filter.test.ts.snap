// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the web filter's renders > IPv4 only: the script and its files keep their hashes 1`] = `
"#!/bin/sh
# Managed by OpsCrew: only Cloudflare's addresses reach the web ports (80 and 443) that Docker
# publishes (IPv4; the site is not published on IPv6). opscrew-web-filter.service runs this before
# Docker, and Docker requires that service: when the filter cannot be installed, Docker does not
# start. \`opscrew destroy --undo-host\` removes it; \`opscrew provision\` updates the ranges.
set -eu
# PATH comes from systemd (or from OpsCrew's step, which runs it once right away).
IPV4='103.21.244.0/22 173.245.48.0/20'
fail() {
  echo "opscrew-web-filter: $1" >&2
  exit 1
}
if [ -f /etc/docker/daemon.json ] && grep -Eq '"firewall-backend"[[:space:]]*:[[:space:]]*"nftables"' /etc/docker/daemon.json; then
  fail "Docker is set to its nftables firewall backend (/etc/docker/daemon.json), which has no DOCKER-USER chain, so OpsCrew's web filter cannot work."
fi
if [ -f /etc/docker/daemon.json ] && grep -Eq '"iptables"[[:space:]]*:[[:space:]]*false' /etc/docker/daemon.json; then
  fail "Docker does not manage iptables (\\"iptables\\": false in /etc/docker/daemon.json), so OpsCrew's web filter cannot work."
fi
docker_unit=$(systemctl show docker -p ExecStart -p Environment 2>/dev/null) || docker_unit=''
case "$docker_unit" in
  *firewall-backend=nftables* | *"firewall-backend nftables"* | *DOCKER_FIREWALL_BACKEND=nftables*)
    fail "Docker's service is set to its nftables firewall backend, which has no DOCKER-USER chain, so OpsCrew's web filter cannot work." ;;
  *--iptables=false*)
    fail "Docker's service does not manage iptables (--iptables=false), so OpsCrew's web filter cannot work." ;;
esac
leading_ok() {
  top=$(iptables -w -S DOCKER-USER 2>/dev/null | grep '^-A ' | head -n 3) || return 1
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    printf '%s\\n' "$top" | grep -- "-p $proto " | grep -- "--ctorigdstport $port " | grep -q -- " -j OPSCREW-WEB\\$" || return 1
  done
}
chain_ok() {
  iptables -w -n -L OPSCREW-WEB >/dev/null 2>&1 || return 1
  rules=$(iptables -w -S OPSCREW-WEB | grep -c '^-A ') || return 1
  n=0
  for net in $1; do
    n=$((n + 1))
    iptables -w -C OPSCREW-WEB -s "$net" -j RETURN 2>/dev/null || return 1
  done
  [ "$rules" -eq $((n + 1)) ] || return 1
  [ "$(iptables -w -S OPSCREW-WEB | grep '^-A ' | tail -n 1)" = "-A OPSCREW-WEB -j DROP" ]
}
command -v iptables >/dev/null 2>&1 || fail "iptables is not installed."
command -v iptables-restore >/dev/null 2>&1 || fail "iptables-restore is not installed."
# OpsCrew's chain in one atomic change: Cloudflare's ranges pass, everything else is dropped.
{
  echo '*filter'
  echo ':OPSCREW-WEB - [0:0]'
  for net in $IPV4; do echo "-A OPSCREW-WEB -s $net -j RETURN"; done
  echo '-A OPSCREW-WEB -j DROP'
  echo 'COMMIT'
} | iptables-restore -w --noflush
# Before Docker starts DOCKER-USER may not exist yet; Docker keeps it and its rules.
iptables -w -n -L DOCKER-USER >/dev/null 2>&1 || iptables -w -N DOCKER-USER
# The jumps for new connections to published ports 80 and 443 come first in DOCKER-USER.
if ! leading_ok; then
  for spec in 'udp 443' 'tcp 443' 'tcp 80'; do
    set -- $spec
    iptables -w -I DOCKER-USER 1 -p "$1" -m conntrack --ctstate DNAT --ctorigdstport "$2" --ctdir ORIGINAL -j OPSCREW-WEB
  done
  # Older copies of the jumps further down go, from the bottom up. The chain is listed again
  # before each delete, and rule n goes only while it still is one of OpsCrew's jumps (another
  # program may have changed the chain in between).
  iptables -w -S DOCKER-USER | grep '^-A ' | awk 'NR > 3 && / -j OPSCREW-WEB$/ { print NR }' | sort -rn |
    while read -r n; do
      rule=$(iptables -w -S DOCKER-USER | grep '^-A ' | sed -n "\${n}p")
      case "$rule" in
        *" -j OPSCREW-WEB") iptables -w -D DOCKER-USER "$n" ;;
      esac
    done
fi
"
`;

exports[`the web filter's renders > IPv4 only: the step's scripts match their snapshot 1`] = `
{
  "apply": "# opscrew-host: web-filter.apply
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
SCRIPT='/usr/local/sbin/opscrew-web-filter'
UNIT_FILE='/etc/systemd/system/opscrew-web-filter.service'
DROP_IN='/etc/systemd/system/docker.service.d/opscrew-web-filter.conf'
SERVICE='opscrew-web-filter.service'
CHAIN='OPSCREW-WEB'
SCRIPT_B64=''
UNIT_B64=''
DROPIN_B64=''
SCRIPT_SHA256='7041f46b3e89fd34e397c4bfda5053ef8c22c52a80f69a6919c0cc96405a962a'
UNIT_SHA256='5ba0c4e7fc47da79c43dd085a0191a240f49e8b3499c4ca253bad677b4893782'
DROPIN_SHA256='97c2a952b4f120ec2d2868592b8fc4fc5e02ce2bc7109fff45f5ce1d4df9ef0a'
IPV4='103.21.244.0/22 173.245.48.0/20'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
leading_ok() {
  top=$(iptables -w -S DOCKER-USER 2>/dev/null | grep '^-A ' | head -n 3) || return 1
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    printf '%s\\n' "$top" | grep -- "-p $proto " | grep -- "--ctorigdstport $port " | grep -q -- " -j OPSCREW-WEB\\$" || return 1
  done
}
chain_ok() {
  iptables -w -n -L OPSCREW-WEB >/dev/null 2>&1 || return 1
  rules=$(iptables -w -S OPSCREW-WEB | grep -c '^-A ') || return 1
  n=0
  for net in $1; do
    n=$((n + 1))
    iptables -w -C OPSCREW-WEB -s "$net" -j RETURN 2>/dev/null || return 1
  done
  [ "$rules" -eq $((n + 1)) ] || return 1
  [ "$(iptables -w -S OPSCREW-WEB | grep '^-A ' | tail -n 1)" = "-A OPSCREW-WEB -j DROP" ]
}
file_is() { [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d ' ' -f 1)" = "$2" ]; }
# Removes OpsCrew's jumps from DOCKER-USER and its chain.
remove_rules() {
  command -v iptables >/dev/null 2>&1 || return 0
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    while iptables -w -C DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN" 2>/dev/null; do
      iptables -w -D DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN"
    done
  done
  if iptables -w -n -L "$CHAIN" >/dev/null 2>&1; then
    iptables -w -F "$CHAIN"
    iptables -w -X "$CHAIN" || fail "Another rule still jumps to OpsCrew's chain $CHAIN; remove that rule, then run the command again."
  fi
}
if [ -f /etc/docker/daemon.json ] && grep -Eq '"firewall-backend"[[:space:]]*:[[:space:]]*"nftables"' /etc/docker/daemon.json; then
  fail "Docker is set to its nftables firewall backend (/etc/docker/daemon.json), which has no DOCKER-USER chain, so OpsCrew's web filter cannot work."
fi
if [ -f /etc/docker/daemon.json ] && grep -Eq '"iptables"[[:space:]]*:[[:space:]]*false' /etc/docker/daemon.json; then
  fail "Docker does not manage iptables (\\"iptables\\": false in /etc/docker/daemon.json), so OpsCrew's web filter cannot work."
fi
docker_unit=$(systemctl show docker -p ExecStart -p Environment 2>/dev/null) || docker_unit=''
case "$docker_unit" in
  *firewall-backend=nftables* | *"firewall-backend nftables"* | *DOCKER_FIREWALL_BACKEND=nftables*)
    fail "Docker's service is set to its nftables firewall backend, which has no DOCKER-USER chain, so OpsCrew's web filter cannot work." ;;
  *--iptables=false*)
    fail "Docker's service does not manage iptables (--iptables=false), so OpsCrew's web filter cannot work." ;;
esac
if systemctl is-active --quiet docker && ! iptables -w -n -L DOCKER-USER >/dev/null 2>&1; then
  fail "Docker is running but has no DOCKER-USER chain in iptables, so OpsCrew's web filter cannot work. Nothing was changed."
fi
install -d -m 0755 "$(dirname "$SCRIPT")" "$(dirname "$UNIT_FILE")"
printf '%s' "$SCRIPT_B64" | base64 -d | write_file "$SCRIPT" 0755
printf '%s' "$UNIT_B64" | base64 -d | write_file "$UNIT_FILE" 0644
"$SCRIPT" || fail "OpsCrew could not install its web filter (see the message above); Docker was not changed."
install -d -m 0755 "$(dirname "$DROP_IN")"
printf '%s' "$DROPIN_B64" | base64 -d | write_file "$DROP_IN" 0644
systemctl daemon-reload
systemctl enable "$SERVICE" >/dev/null
# Starting the unit runs the script once more (no change); Docker is not restarted.
systemctl start "$SERVICE"
",
  "check": "# opscrew-host: web-filter.check
