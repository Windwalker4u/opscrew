  rules=$(iptables -w -S OPSCREW-WEB | grep -c '^-A ') || return 1
  n=0
  for net in $1; do
    n=$((n + 1))
    iptables -w -C OPSCREW-WEB -s "$net" -j RETURN 2>/dev/null || return 1
  done
  [ "$rules" -eq $((n + 1)) ] || return 1
  [ "$(iptables -w -S OPSCREW-WEB | grep '^-A ' | tail -n 1)" = "-A OPSCREW-WEB -j DROP" ]
}
file_is() { [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d ' ' -f 1)" = "$2" ]; }
# Removes OpsCrew's jumps from DOCKER-USER and its chain.
remove_rules() {
  command -v iptables >/dev/null 2>&1 || return 0
  for spec in 'tcp 80' 'tcp 443' 'udp 443'; do
    proto=\${spec% *}
    port=\${spec#* }
    while iptables -w -C DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN" 2>/dev/null; do
      iptables -w -D DOCKER-USER -p "$proto" -m conntrack --ctstate DNAT --ctorigdstport "$port" --ctdir ORIGINAL -j "$CHAIN"
    done
  done
  if iptables -w -n -L "$CHAIN" >/dev/null 2>&1; then
    iptables -w -F "$CHAIN"
    iptables -w -X "$CHAIN" || fail "Another rule still jumps to OpsCrew's chain $CHAIN; remove that rule, then run the command again."
  fi
}
table6_ok() {
  listing=$(nft list table inet opscrew-web 2>/dev/null) || return 1
  printf '%s\\n' "$listing" | grep -q 'hook input ' || return 1
  printf '%s\\n' "$listing" | grep -q 'hook forward ' || return 1
  n=0
  for net in $1; do
    n=$((n + 1))
    [ "$(printf '%s\\n' "$listing" | grep -cF -- "ip6 saddr $net ")" -eq 3 ] || return 1
  done
  [ "$(printf '%s\\n' "$listing" | grep -c ' accept$')" -eq $((3 * n + 1)) ] || return 1
  [ "$(printf '%s\\n' "$listing" | grep -c ' drop$')" -eq 3 ]
}
if [ -f /etc/docker/daemon.json ] && grep -Eq '"firewall-backend"[[:space:]]*:[[:space:]]*"nftables"' /etc/docker/daemon.json; then
  fail "Docker is set to its nftables firewall backend (/etc/docker/daemon.json), which has no DOCKER-USER chain, so OpsCrew's web filter cannot work."
fi
if [ -f /etc/docker/daemon.json ] && grep -Eq '"iptables"[[:space:]]*:[[:space:]]*false' /etc/docker/daemon.json; then
  fail "Docker does not manage iptables (\\"iptables\\": false in /etc/docker/daemon.json), so OpsCrew's web filter cannot work."
fi
docker_unit=$(systemctl show docker -p ExecStart -p Environment 2>/dev/null) || docker_unit=''
case "$docker_unit" in
  *firewall-backend=nftables* | *"firewall-backend nftables"* | *DOCKER_FIREWALL_BACKEND=nftables*)
    fail "Docker's service is set to its nftables firewall backend, which has no DOCKER-USER chain, so OpsCrew's web filter cannot work." ;;
  *--iptables=false*)
    fail "Docker's service does not manage iptables (--iptables=false), so OpsCrew's web filter cannot work." ;;
esac
if systemctl is-active --quiet docker && ! iptables -w -n -L DOCKER-USER >/dev/null 2>&1; then
  fail "Docker is running but has no DOCKER-USER chain in iptables, so OpsCrew's web filter cannot work. Nothing was changed."
fi
install -d -m 0755 "$(dirname "$SCRIPT")" "$(dirname "$UNIT_FILE")"
printf '%s' "$SCRIPT_B64" | base64 -d | write_file "$SCRIPT" 0755
printf '%s' "$UNIT_B64" | base64 -d | write_file "$UNIT_FILE" 0644
"$SCRIPT" || fail "OpsCrew could not install its web filter (see the message above); Docker was not changed."
install -d -m 0755 "$(dirname "$DROP_IN")"
printf '%s' "$DROPIN_B64" | base64 -d | write_file "$DROP_IN" 0644
systemctl daemon-reload
systemctl enable "$SERVICE" >/dev/null
# Starting the unit runs the script once more (no change); Docker is not restarted.
systemctl start "$SERVICE"
