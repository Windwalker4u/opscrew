// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderDrill > is the same compose file for the same inputs (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml for a restore drill of the snapshot 20261118T120000Z:
# a copy of the app and its data with no internet, no published port and no site, and none of
# the app's .env values. opscrew restore --drill starts it and removes it.
name: shop-drill
services:
  app:
    image: ghcr.io/acme/shop@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    restart: "no"
    env_file:
      - app.env
    environment:
      PORT: "3000"
    healthcheck:
      test:
        - CMD
        - bash
        - -c
        - "exec 3<>/dev/tcp/127.0.0.1/3000 && printf 'GET %s HTTP/1.0\\\\r\\\\nHost: 127.0.0.1\\\\r\\\\n\\\\r\\\\n' '/api/health' >&3 && read -r _ code _ <&3 && [ \\"$\${code%$$'\\\\r'}\\" = 200 ]"
      interval: 5s
      timeout: 3s
      retries: 3
      start_period: 30s
      start_interval: 1s
    stop_grace_period: 35s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      db:
        condition: service_healthy
      cache:
        condition: service_healthy
  db:
    image: <pin:IMAGES.postgres>
    restart: "no"
    env_file:
      - db.env
    volumes:
      - /srv/data/shop-drill/db:/var/lib/postgresql/data
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $\${POSTGRES_USER} -d $\${POSTGRES_DB}
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  cache:
    image: <pin:IMAGES.redis>
    restart: "no"
    command:
      - sh
      - -c
      - "umask 077 && { [ -f /tmp/opscrew-users.acl ] || { { h=$$(printf %s \\"$$REDIS_PASSWORD\\" | sha256sum | cut -d ' ' -f 1); printf 'user %s on #%s %s\\\\n' default \\"$$h\\" '~* &* +@all'; printf '%s\\\\n' \\"$$OPSCREW_ACL_USERS\\" | while IFS=: read -r name access hash; do case \\"$$access\\" in read-only) rules='~* &* +@read +ping +hello +client|setname +client|setinfo -@write' ;; full) rules='~* &* +@all -@admin' ;; *) continue ;; esac; printf 'user %s on #%s %s\\\\n' \\"$$name\\" \\"$$hash\\" \\"$$rules\\"; done; } > /tmp/opscrew-users.acl && chown redis:redis /tmp/opscrew-users.acl; }; } && { [ -f /tmp/opscrew-password ] || (umask 077 && printf %s \\"$$REDIS_PASSWORD\\" > /tmp/opscrew-password); } && exec docker-entrypoint.sh redis-server --aclfile /tmp/opscrew-users.acl --save '' --appendonly no --maxmemory 96mb --maxmemory-policy allkeys-lru"
    env_file:
      - cache.env
    volumes:
      - /srv/data/shop-drill/cache:/data
    healthcheck:
      test:
        - CMD-SHELL
        - REDISCLI_AUTH="$$(cat /tmp/opscrew-password)" redis-cli ping | grep -q PONG
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 128m
    memswap_limit: 128m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal:
    internal: true
"
`;
