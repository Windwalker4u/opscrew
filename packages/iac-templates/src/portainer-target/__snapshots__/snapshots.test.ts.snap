// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the off-server copy in a stack > matches the snapshot 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The app's stack in your Portainer. The deploy workflow fills in the image it built and writes
# this file to the opscrew-deploy branch, which Portainer deploys. The variables' values live only
# in the stack's environment in Portainer.
# \`release\` runs app.releaseCommand from opscrew/plan.yaml before each new version starts.
name: opscrew-shop
services:
  app:
    image: __OPSCREW_APP_IMAGE__
    restart: unless-stopped
    environment:
      PORT: "3000"
      AMQP_URL: \${AMQP_URL}
      DATABASE_URL: \${DATABASE_URL}
      RABBITMQ_URL: \${RABBITMQ_URL}
      REDIS_URL: \${REDIS_URL}
    volumes:
      - sqlite:/app/data
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      db:
        condition: service_healthy
      queue:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      snapshot:
        condition: service_completed_successfully
      release:
        condition: service_completed_successfully
  release:
    image: __OPSCREW_APP_IMAGE__
    environment:
      PORT: "3000"
      AMQP_URL: \${AMQP_URL}
      DATABASE_URL: \${DATABASE_URL}
      RABBITMQ_URL: \${RABBITMQ_URL}
      REDIS_URL: \${REDIS_URL}
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
    volumes:
      - sqlite:/app/data
    command:
      - if [ "$$OPSCREW_RELEASE" = skip ]; then exit 0; fi; npm run migrate
    mem_limit: 512m
    memswap_limit: 512m
    depends_on:
      db:
        condition: service_healthy
      queue:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      snapshot:
        condition: service_completed_successfully
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
  db:
    image: <pin:IMAGES.postgres>
    restart: unless-stopped
    environment:
      POSTGRES_USER: \${OPSCREW_DB_USER}
      POSTGRES_DB: \${OPSCREW_DB_NAME}
      POSTGRES_PASSWORD: \${OPSCREW_DB_PASSWORD}
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $\${POSTGRES_USER} -d $\${POSTGRES_DB}
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  queue:
    image: <pin:IMAGES.valkey>
    restart: unless-stopped
    command:
      - sh
      - -c
      - "umask 077 && { [ -f /tmp/opscrew-users.acl ] || { { h=$$(printf %s \\"$$VALKEY_PASSWORD\\" | sha256sum | cut -d ' ' -f 1); printf 'user %s on #%s %s\\\\n' default \\"$$h\\" '~* &* +@all'; printf '%s\\\\n' \\"$$OPSCREW_ACL_USERS\\" | while IFS=: read -r name access hash; do case \\"$$access\\" in read-only) rules='~* &* +@read +ping +hello +client|setname +client|setinfo -@write' ;; full) rules='~* &* +@all -@admin' ;; *) continue ;; esac; printf 'user %s on #%s %s\\\\n' \\"$$name\\" \\"$$hash\\" \\"$$rules\\"; done; } > /tmp/opscrew-users.acl && chown valkey:valkey /tmp/opscrew-users.acl; }; } && { [ -f /tmp/opscrew-password ] || (umask 077 && printf %s \\"$$VALKEY_PASSWORD\\" > /tmp/opscrew-password); } && exec docker-entrypoint.sh valkey-server --aclfile /tmp/opscrew-users.acl --appendonly yes --maxmemory 96mb --maxmemory-policy noeviction"
    environment:
      VALKEY_PASSWORD: \${OPSCREW_SVC_QUEUE_PASSWORD}
    volumes:
      - queue_data:/data
    healthcheck:
      test:
        - CMD-SHELL
        - REDISCLI_AUTH="$$(cat /tmp/opscrew-password)" valkey-cli ping | grep -q PONG
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 128m
    memswap_limit: 128m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  rabbitmq:
    image: <pin:IMAGES.rabbitmq>
    restart: unless-stopped
    hostname: rabbitmq
    environment:
      RABBITMQ_DEFAULT_USER: app
      RABBITMQ_DEFAULT_PASS: \${OPSCREW_SVC_RABBITMQ_PASSWORD}
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    configs:
      - source: rabbitmq-rabbitmq.conf
        target: /etc/rabbitmq/conf.d/90-opscrew.conf
    labels:
      dev.opscrew.config-sha256: 9217459ea18f0311c6452502c7e7d895fccb8ab6854edbf944cef6323b5a20fe
    healthcheck:
      test:
        - CMD
        - rabbitmq-diagnostics
        - -q
        - ping
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 30s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  snapshot-db:
    image: <pin:IMAGES.postgres>
    restart: no
    user: 0:0
    environment:
      POSTGRES_USER: \${OPSCREW_DB_USER}
      POSTGRES_DB: \${OPSCREW_DB_NAME}
      POSTGRES_PASSWORD: \${OPSCREW_DB_PASSWORD}
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    entrypoint:
      - sh
      - -c
      - |-
        take() {
          mkdir -p "$$1" && rm -f "$$1"/db.done "$$1"/db.failed "$$1"/db.skipped || return 1
          t="$$1"/db.dump.tmp
          (umask 077 && export PGPASSWORD="$$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f "$$t" app); r=$$?
          if [ "$$r" = 0 ] && mv "$$t" "$$1"/db.dump; then
            touch "$$1"/db.done
          elif [ "$$r" = 3 ]; then
            rm -f "$$t"; touch "$$1"/db.skipped
          else
            rm -f "$$t"; touch "$$1"/db.failed
            echo 'OpsCrew: the snapshot of db failed; its output is above.' >&2
            return 1
          fi
        }
        if [ "$$OPSCREW_RELEASE" = skip ] || [ ! -f /snapshots/.running ]; then exit 0; fi
        out=$$(cat /snapshots/.running)
        if [ "$$out" = "$$OPSCREW_APP_IMAGE" ]; then exit 0; fi
        hex=$\${out##*@sha256:}
        case "$$hex" in *[!0-9a-f]*) hex= ;; esac
        if [ "$\${#hex}" -ne 64 ]; then
          echo 'OpsCrew: /snapshots/.running in the snapshots volume names no image pinned by digest, so the snapshot before this release can'\\''t be taken.' >&2
          exit 1
        fi
        take /snapshots/"$$hex".partial
    volumes:
      - db_data:/var/lib/postgresql/data:ro
      - snapshots:/snapshots
    depends_on:
      db:
        condition: service_healthy
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  snapshot-queue:
    image: <pin:IMAGES.valkey>
    restart: no
    user: 0:0
    environment:
      VALKEY_PASSWORD: \${OPSCREW_SVC_QUEUE_PASSWORD}
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    entrypoint:
      - sh
      - -c
      - |-
        take() {
          mkdir -p "$$1" && rm -f "$$1"/queue.done "$$1"/queue.failed "$$1"/queue.skipped || return 1
          t="$$1"/queue.rdb.tmp
          (umask 077 && export REDISCLI_AUTH="$$VALKEY_PASSWORD" && valkey-cli -h queue --rdb "$$t"); r=$$?
          if [ "$$r" = 0 ] && mv "$$t" "$$1"/queue.rdb; then
            touch "$$1"/queue.done
          elif [ "$$r" = 3 ]; then
            rm -f "$$t"; touch "$$1"/queue.skipped
          else
            rm -f "$$t"; touch "$$1"/queue.failed
            echo 'OpsCrew: the snapshot of queue failed; its output is above.' >&2
            return 1
          fi
        }
        if [ "$$OPSCREW_RELEASE" = skip ] || [ ! -f /snapshots/.running ]; then exit 0; fi
        out=$$(cat /snapshots/.running)
        if [ "$$out" = "$$OPSCREW_APP_IMAGE" ]; then exit 0; fi
        hex=$\${out##*@sha256:}
        case "$$hex" in *[!0-9a-f]*) hex= ;; esac
        if [ "$\${#hex}" -ne 64 ]; then
          echo 'OpsCrew: /snapshots/.running in the snapshots volume names no image pinned by digest, so the snapshot before this release can'\\''t be taken.' >&2
          exit 1
        fi
        take /snapshots/"$$hex".partial
    volumes:
      - queue_data:/data:ro
      - snapshots:/snapshots
    depends_on:
      queue:
        condition: service_healthy
    mem_limit: 128m
    memswap_limit: 128m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  snapshot-sqlite:
    image: <pin:IMAGES.python>
    restart: no
    user: 0:0
    network_mode: none
    environment:
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    entrypoint:
      - sh
      - -c
      - |-
        take() {
          mkdir -p "$$1" && rm -f "$$1"/sqlite.done "$$1"/sqlite.failed "$$1"/sqlite.skipped || return 1
          t="$$1"/sqlite.tar.tmp
          (umask 077 && python3 -c 'import os, sqlite3, sys, tarfile, tempfile
        d = sys.argv[1]
        s = os.stat(d)
        os.setgroups([])
        os.setgid(s.st_gid)
        os.setuid(s.st_uid)
        if not os.listdir(d):
            print("OpsCrew: the app'\\''s SQLite volume is empty, so the snapshot holds nothing of it.", file=sys.stderr)
            sys.exit(3)
        def numeric(info):
            info.uname = info.gname = ""
            return info
        def database(path):
            if os.path.islink(path) or not os.path.isfile(path):
                return False
            with open(path, "rb") as f:
                return f.read(16) == b"SQLite format 3\\x00"
        with tempfile.TemporaryDirectory() as tmp:
            copy = os.path.join(tmp, "copy")
            with tarfile.open(fileobj=sys.stdout.buffer, mode="w|", format=tarfile.GNU_FORMAT) as tar:
                for root, dirs, files in os.walk(d):
                    dirs.sort()
                    tar.add(root, os.path.relpath(root, d), recursive=False, filter=numeric)
                    for name in sorted(files):
                        path = os.path.join(root, name)
                        arcname = os.path.relpath(path, d)
                        if name.endswith(("-wal", "-shm", "-journal")):
                            continue
                        if not database(path):
                            tar.add(path, arcname, recursive=False, filter=numeric)
                            continue
                        src = sqlite3.connect("file:" + path + "?mode=rw", uri=True)
                        dst = sqlite3.connect(copy)
                        src.backup(dst)
                        src.close()
                        dst.execute("pragma journal_mode=delete")
                        dst.close()
                        info = numeric(tar.gettarinfo(path, arcname))
                        info.size = os.path.getsize(copy)
                        with open(copy, "rb") as f:
                            tar.addfile(info, f)
                        os.remove(copy)' /sqlite > "$$t"); r=$$?
          if [ "$$r" = 0 ] && mv "$$t" "$$1"/sqlite.tar; then
            touch "$$1"/sqlite.done
          elif [ "$$r" = 3 ]; then
            rm -f "$$t"; touch "$$1"/sqlite.skipped
          else
            rm -f "$$t"; touch "$$1"/sqlite.failed
            echo 'OpsCrew: the snapshot of sqlite failed; its output is above.' >&2
            return 1
          fi
        }
        if [ "$$OPSCREW_RELEASE" = skip ] || [ ! -f /snapshots/.running ]; then exit 0; fi
        out=$$(cat /snapshots/.running)
        if [ "$$out" = "$$OPSCREW_APP_IMAGE" ]; then exit 0; fi
        hex=$\${out##*@sha256:}
        case "$$hex" in *[!0-9a-f]*) hex= ;; esac
        if [ "$\${#hex}" -ne 64 ]; then
          echo 'OpsCrew: /snapshots/.running in the snapshots volume names no image pinned by digest, so the snapshot before this release can'\\''t be taken.' >&2
          exit 1
        fi
        take /snapshots/"$$hex".partial
    volumes:
      - sqlite:/sqlite
      - snapshots:/snapshots
    mem_limit: 128m
    memswap_limit: 128m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
  snapshot:
    image: <pin:IMAGES.busybox>
    user: 0:0
    network_mode: none
    restart: no
    environment:
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    depends_on:
      snapshot-db:
        condition: service_completed_successfully
      snapshot-queue:
        condition: service_completed_successfully
      snapshot-sqlite:
        condition: service_completed_successfully
    entrypoint:
      - sh
      - -c
      - |-
        finish() {
          img=$$(cat /snapshots/.running 2> /dev/null)
          {
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$$2" "$$3" "$$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$\${img##*@}"
            if [ -f "$$1"/db.done ] && [ -f "$$1"/db.dump ]; then
              printf '{"name":"db","kind":"postgres","file":"db.dump","size":%s,"image":"<pin:IMAGES.postgres>"}' "$$(stat -c %s "$$1"/db.dump)"
            elif [ -f "$$1"/db.skipped ]; then
              printf '{"name":"db","kind":"postgres","skipped":true}'
            else
              printf '{"name":"db","kind":"postgres","failed":true}'
            fi
            printf ,
            if [ -f "$$1"/queue.done ] && [ -f "$$1"/queue.rdb ]; then
              printf '{"name":"queue","kind":"valkey","file":"queue.rdb","size":%s,"image":"<pin:IMAGES.valkey>"}' "$$(stat -c %s "$$1"/queue.rdb)"
            elif [ -f "$$1"/queue.skipped ]; then
              printf '{"name":"queue","kind":"valkey","skipped":true}'
            else
              printf '{"name":"queue","kind":"valkey","failed":true}'
            fi
            printf ,
            if [ -f "$$1"/sqlite.done ] && [ -f "$$1"/sqlite.tar ]; then
              printf '{"name":"sqlite","kind":"sqlite","file":"sqlite.tar","size":%s}' "$$(stat -c %s "$$1"/sqlite.tar)"
            elif [ -f "$$1"/sqlite.skipped ]; then
              printf '{"name":"sqlite","kind":"sqlite","skipped":true}'
            else
              printf '{"name":"sqlite","kind":"sqlite","failed":true}'
            fi
            printf ']}\\n'
          } > "$$1"/.about || return 1
          rm -f "$$1"/*.done "$$1"/*.failed "$$1"/*.skipped "$$1"/*.tmp
          mv "$$1"/.about "$$1"/about.json && chown -R 0:0 "$$1" && chmod 600 "$$1"/* && chmod 700 "$$1" || return 1
          rm -rf /snapshots/"$$2" && mv "$$1" /snapshots/"$$2"
        }
        prune() {
          for d in /snapshots/*; do
            case "$$d" in *.partial|*.taking) continue ;; esac
            if [ -f "$$d"/about.json ] && grep -q "\\"kind\\":\\"$$1\\"" "$$d"/about.json; then echo "$$(sed -n 's/.*"taken":"\\([^"]*\\)".*/\\1/p' "$$d"/about.json) $$d"; fi
          done | sort -r | sed "1,$$2d" | while read -r _ d; do rm -rf "$$d"; done
        }
        if [ -f /snapshots/.restored ] && [ "$$(sed -n '1s/.*@//p' /snapshots/.restored)" != "$\${OPSCREW_APP_IMAGE##*@}" ]; then
          echo "OpsCrew: opscrew rollback restored this stack's data for $$(sed -n 1p /snapshots/.restored), so no other version starts on it until that rollback ends (/snapshots/.restored names it). If that rollback is stuck, run $$(sed -n 2p /snapshots/.restored) on the computer that ran it; it finishes the rollback and removes /snapshots/.restored." >&2
          exit 1
        fi
        if [ "$$OPSCREW_RELEASE" = skip ] || [ ! -f /snapshots/.running ]; then exit 0; fi
        out=$$(cat /snapshots/.running)
        if [ "$$out" = "$$OPSCREW_APP_IMAGE" ]; then exit 0; fi
        hex=$\${out##*@sha256:}
        case "$$hex" in *[!0-9a-f]*) hex= ;; esac
        if [ "$\${#hex}" -ne 64 ]; then
          echo 'OpsCrew: /snapshots/.running in the snapshots volume names no image pinned by digest, so the snapshot before this release can'\\''t be taken.' >&2
          exit 1
        fi
        finish /snapshots/"$$hex".partial "$$hex" release && prune release 3
    volumes:
      - snapshots:/snapshots
    mem_limit: 16m
    memswap_limit: 16m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
  offsite:
    image: <pin:IMAGES.rclone>
    restart: unless-stopped
    user: 0:0
    environment:
      RCLONE_CONFIG_OFFSITE_TYPE: s3
      RCLONE_CONFIG_OFFSITE_PROVIDER: Hetzner
      RCLONE_CONFIG_OFFSITE_REGION: fsn1
      RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET: "true"
      RCLONE_CONFIG_OFFSITE_ENDPOINT: \${OPSCREW_OFFSITE_ENDPOINT}
      RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID: \${OPSCREW_OFFSITE_ACCESS_KEY_ID}
      RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY: \${OPSCREW_OFFSITE_SECRET_ACCESS_KEY}
      OPSCREW_OFFSITE_RECIPIENT: \${OPSCREW_OFFSITE_RECIPIENT}
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -o pipefail
        age_ok() { echo '<pin:TOOLS.age.sha256.amd64>  /tools/age.tar.gz' | sha256sum -c -s && rm -rf /tmp/age && mkdir /tmp/age && tar -xzf /tools/age.tar.gz -C /tmp/age age/age; }
        age_fetch() { rm -rf /tmp/age && mkdir /tmp/age && rclone copyurl 'https://github.com/FiloSottile/age/releases/download/v1.3.2/age-v1.3.2-linux-amd64.tar.gz' /tmp/age/age.tar.gz && mv /tmp/age/age.tar.gz /tools/age.tar.gz.new && mv /tools/age.tar.gz.new /tools/age.tar.gz && age_ok; }
        age_ready() { age_ok || age_fetch || { echo 'OpsCrew: age could not be fetched and checked against its pinned SHA-256.' >&2; return 1; }; }
        put() {
          age_ready || return 1
          /tmp/age/age/age -r "$$OPSCREW_OFFSITE_RECIPIENT" < "$$1" | rclone rcat 'offsite:shop-prod-backups/backups/'"$$2"
        }
        umask 077
        while :; do
          for d in /snapshots/*; do
            case "$$d" in *.partial|*.taking) continue ;; esac
            case "$\${d##*/}" in *[!0-9a-f]*) ;; *) continue ;; esac
            if [ ! -f "$$d"/about.json ] || [ -e "$$d"/offsite.done ]; then continue; fi
            id=$\${d##*/}; ok=1
            for f in "$$d"/*; do
              case "$\${f##*/}" in about.json|offsite.done) continue ;; esac
              put "$$f" "$$id/$\${f##*/}.age" || ok=0
            done
            if [ "$$ok" = 1 ] && put "$$d"/about.json "$$id"/about.json.age; then
              touch "$$d"/offsite.done
            else
              echo "OpsCrew: the off-server copy of the snapshot $$id failed; trying again in a minute." >&2
            fi
          done
          sleep 60
        done
    volumes:
      - snapshots:/snapshots
      - snapshot_tools:/tools
    mem_limit: 256m
    memswap_limit: 256m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  stamp:
    image: <pin:IMAGES.curl>
    restart: no
    user: 0:0
    network_mode: none
    environment:
      OPSCREW_APP_VERSION: __OPSCREW_APP_VERSION__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    entrypoint:
      - /bin/sh
      - -c
      - printf '%s\\n' "$$OPSCREW_APP_VERSION" > /version/version && printf '%s\\n' "$$OPSCREW_APP_IMAGE" > /snapshots/.running.tmp && mv /snapshots/.running.tmp /snapshots/.running
    volumes:
      - version:/version
      - snapshots:/snapshots
    depends_on:
      app:
        condition: service_started
    read_only: true
    mem_limit: 16m
    memswap_limit: 16m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  caddy:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    labels:
      dev.opscrew.caddyfile-sha256: 691a6baa89ea453dfdbb3886faa7be0167973ed80190244915cece31816d1d86
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    volumes:
      - version:/srv/opscrew-version:ro
    depends_on:
      - app
    mem_limit: 64m
    memswap_limit: 64m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  cloudflared:
    image: <pin:IMAGES.cloudflared>
    restart: unless-stopped
    command:
      - tunnel
      - --no-autoupdate
      - --metrics
      - 127.0.0.1:20241
      - run
    environment:
      TUNNEL_TOKEN: \${OPSCREW_TUNNEL_TOKEN}
    depends_on:
      - caddy
    mem_limit: 32m
    memswap_limit: 32m
    read_only: true
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
networks:
  internal: {}
volumes:
  db_data: {}
  queue_data: {}
  rabbitmq_data: {}
  sqlite: {}
  snapshots: {}
  snapshot_tools: {}
  version: {}
configs:
  caddyfile:
    content: |
      # Served through a Cloudflare Tunnel: Cloudflare terminates TLS, Caddy serves plain HTTP.
      http://shop.example.com {
      	@http_visitor header Cf-Visitor \`*"http"*\`
      	redir @http_visitor https://{host}{uri} 308
      	handle /.well-known/opscrew-version {
      		root * /srv/opscrew-version
      		rewrite * /version
      		file_server
      	}
      	encode zstd gzip
      	reverse_proxy app:3000 {
      		lb_try_duration 30s
      		lb_try_interval 250ms
      	}
      	header {
      		Strict-Transport-Security "max-age=31536000; includeSubDomains"
      		-Server
      		-X-Powered-By
      	}
      	header ?X-Content-Type-Options "nosniff"
      	header ?X-Frame-Options "SAMEORIGIN"
      	header ?Referrer-Policy "strict-origin-when-cross-origin"
      	handle_errors {
      		header {
      			Strict-Transport-Security "max-age=31536000; includeSubDomains"
      			-Server
      			-X-Powered-By
      		}
      		header ?X-Content-Type-Options "nosniff"
      		header ?X-Frame-Options "SAMEORIGIN"
      		header ?Referrer-Policy "strict-origin-when-cross-origin"
      		respond "{err.status_code} {err.status_text}" {err.status_code}
      	}
      }
  rabbitmq-rabbitmq.conf:
    content: |
      # Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
      # RabbitMQ settings for its 512 MB memory limit, loaded after the image's own.
      # The memory alarm blocks publishers well before Docker's limit would stop the node.
      vm_memory_high_watermark.absolute = 204MB
      # The default user is \`app\` (RABBITMQ_DEFAULT_USER), so RabbitMQ never creates \`guest\`; were
      # it there, it could log in only from inside the container.
      loopback_users.guest = true
"
`;

exports[`the scheduled drills in a stack > matches the snapshot 1`] = `
{
  "entrypoint": [
    "sh",
    "-c",
    "S=/var/lib/postgresql/data/drill
drill_record() {
  echo "drill-record $$(date -u +%Y-%m-%dT%H:%M:%SZ) scheduled $$1 id=$\${drill_id:--} version=$\${drill_version:--} start=$$drill_start parts=$\${drill_parts:--} health=- tables=$\${drill_tables:--} removal=$\${drill_removal:--} cleaned=$$drill_cleaned reason=$\${2:--}"
}
drill_clear() {
  if [ -n "$$drill_watch" ]; then kill "$$drill_watch" 2> /dev/null; wait "$$drill_watch" 2> /dev/null; fi
  if [ -n "$$drill_pid" ]; then kill -s INT "$$drill_pid" 2> /dev/null; wait "$$drill_pid" 2> /dev/null; fi
  drill_watch=""; drill_pid=""
  rm -rf "$$S" 2> /dev/null
  [ ! -e "$$S" ]
}
drill_end() {
  drill_result="$$1"; drill_reason="$$2"
  if [ -e "$$S"/.timed-out ]; then drill_result=failed; drill_reason=timeout; fi
  if drill_clear; then drill_removal=removed; else drill_removal=failed; fi
  drill_record "$$drill_result" "$$drill_reason"
}
drill() {
  drill_start="$$(date -u +%Y-%m-%dT%H:%M:%SZ)"; drill_cleaned=no; drill_id=""; drill_version=""
  drill_parts=""; drill_tables=""; drill_removal=""; drill_pid=""; drill_watch=""
  if [ -e "$$S" ]; then
    rm -rf "$$S" 2> /dev/null
    if [ -e "$$S" ]; then drill_record failed leftovers; return; fi
    drill_cleaned=yes
  fi
  for d in /snapshots/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z; do
    if [ -f "$$d"/about.json ] && grep -qF '"kind":"scheduled"' "$$d"/about.json; then drill_id="$\${d##*/}"; fi
  done
  if [ -z "$$drill_id" ] || [ ! -f /snapshots/"$$drill_id"/db.dump ] || ! grep -qF '"name":"db","kind":"postgres","file":"db.dump"' /snapshots/"$$drill_id"/about.json; then
    drill_record skipped none
    return
  fi
  drill_version="$$(sed -n 's/.*"version":"sha256:\\([0-9a-f]\\{12\\}\\).*/\\1/p' /snapshots/"$$drill_id"/about.json)"
  drill_bytes="$$(wc -c < /snapshots/"$$drill_id"/db.dump | tr -d ' ')"
  set -- $$(df -Pk /var/lib/postgresql/data | tail -n 1)
  drill_margin=$$(( $$2 / 10 )); if [ "$$drill_margin" -lt 1048576 ]; then drill_margin=1048576; fi
  if [ "$$4" -lt $$(( drill_bytes / 1024 + drill_margin )) ]; then drill_record skipped disk; return; fi
  drill_free="$$(sed -n 's/^MemAvailable: *\\([0-9]*\\) kB$$/\\1/p' /proc/meminfo 2> /dev/null)"
  if [ -n "$$drill_free" ] && [ $$(( drill_free / 1024 )) -lt 512 ]; then drill_record skipped memory; return; fi
  { mkdir -p "$$S" && chown postgres:postgres "$$S" && chmod 700 "$$S"; } || { drill_end failed start; return; }
  ("$$(command -v gosu || command -v su-exec)" postgres initdb -D "$$S"/data -U app --auth=trust) < /dev/null >> "$$S"/log 2>&1 || { drill_end failed start; return; }
  "$$(command -v gosu || command -v su-exec)" postgres postgres -D "$$S"/data -c listen_addresses=localhost < /dev/null >> "$$S"/log 2>&1 &
  drill_pid=$$!
  (
    drill_sleep=""
    trap 'kill "$$drill_sleep" 2> /dev/null; exit 0' TERM
    sleep 1800 &
    drill_sleep=$$!
    wait "$$drill_sleep" || exit 0
    : > "$$S"/.timed-out
    kill -s KILL "$$drill_pid"
  ) < /dev/null > /dev/null 2>&1 &
  drill_watch=$$!
  drill_wait=0
  until (pg_isready -q -h localhost) < /dev/null > /dev/null 2>&1; do
    drill_wait=$$((drill_wait + 1))
    if [ "$$drill_wait" -ge 300 ] || [ -e "$$S"/.timed-out ]; then { drill_end failed start; return; }; fi
    sleep 1
  done
  drill_t="$$(date +%s)"
  (umask 077 && export PGPASSWORD="$$POSTGRES_PASSWORD" && psql -X -q -h localhost -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h localhost -U app -d app --no-owner --single-transaction /snapshots/"$$drill_id"/db.dump) < /dev/null >> "$$S"/log 2>&1 || { drill_end not-restored db; return; }
  drill_parts="db:$$drill_bytes:$$(( $$(date +%s) - drill_t ))"
  drill_n="$$( (export PGPASSWORD="$$POSTGRES_PASSWORD" && pg_isready -q -h localhost -U app -d app && psql -X -q -At -h localhost -U app -d app -c "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema NOT IN ('pg_catalog', 'information_schema')") < /dev/null 2>> "$$S"/log | tr -d ' \\r' | tail -n 1)"
  case "$$drill_n" in "" | *[!0-9]*) drill_n=failed ;; esac
  drill_tables="db:$$drill_n"
  case "$$drill_n" in failed | 0) { drill_end not-restored db; return; } ;; esac
  drill_end healthy
}
while :; do
  now=$$(date +%s)
  slot=$$(( ((now - $$OPSCREW_DRILL_AFTER) / $$OPSCREW_DRILL_EVERY + 1) * $$OPSCREW_DRILL_EVERY + $$OPSCREW_DRILL_AFTER ))
  sleep $$(( slot - now ))
  drill
done",
  ],
  "environment": {
    "OPSCREW_DRILL_AFTER": "10800",
    "OPSCREW_DRILL_EVERY": "604800",
  },
  "image": "<pin:IMAGES.postgres>",
  "logging": {
    "driver": "json-file",
    "options": {
      "max-file": "3",
      "max-size": "10m",
    },
  },
  "mem_limit": "512m",
  "memswap_limit": "512m",
  "network_mode": "none",
  "restart": "unless-stopped",
  "security_opt": [
    "no-new-privileges:true",
  ],
  "user": "0:0",
  "volumes": [
    {
      "read_only": true,
      "source": "snapshots",
      "target": "/snapshots",
      "type": "volume",
    },
    {
      "source": "db_drill",
      "target": "/var/lib/postgresql/data",
      "type": "volume",
    },
  ],
}
`;

exports[`the scheduled snapshots in a stack > matches the snapshot 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The app's stack in your Portainer. The deploy workflow fills in the image it built and writes
# this file to the opscrew-deploy branch, which Portainer deploys. The variables' values live only
# in the stack's environment in Portainer.
# \`release\` runs app.releaseCommand from opscrew/plan.yaml before each new version starts.
name: opscrew-shop
services:
  app:
    image: __OPSCREW_APP_IMAGE__
    restart: unless-stopped
    environment:
      PORT: "3000"
      AMQP_URL: \${AMQP_URL}
      DATABASE_URL: \${DATABASE_URL}
      RABBITMQ_URL: \${RABBITMQ_URL}
      REDIS_URL: \${REDIS_URL}
    volumes:
      - sqlite:/app/data
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      db:
        condition: service_healthy
      queue:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      snapshot:
        condition: service_completed_successfully
      release:
        condition: service_completed_successfully
  release:
    image: __OPSCREW_APP_IMAGE__
    environment:
      PORT: "3000"
      AMQP_URL: \${AMQP_URL}
      DATABASE_URL: \${DATABASE_URL}
      RABBITMQ_URL: \${RABBITMQ_URL}
      REDIS_URL: \${REDIS_URL}
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
    volumes:
      - sqlite:/app/data
    command:
      - if [ "$$OPSCREW_RELEASE" = skip ]; then exit 0; fi; npm run migrate
    mem_limit: 512m
    memswap_limit: 512m
    depends_on:
      db:
        condition: service_healthy
      queue:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      snapshot:
        condition: service_completed_successfully
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
  db:
    image: <pin:IMAGES.postgres>
    restart: unless-stopped
    environment:
      POSTGRES_USER: \${OPSCREW_DB_USER}
      POSTGRES_DB: \${OPSCREW_DB_NAME}
      POSTGRES_PASSWORD: \${OPSCREW_DB_PASSWORD}
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $\${POSTGRES_USER} -d $\${POSTGRES_DB}
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  queue:
    image: <pin:IMAGES.valkey>
    restart: unless-stopped
    command:
      - sh
      - -c
      - "umask 077 && { [ -f /tmp/opscrew-users.acl ] || { { h=$$(printf %s \\"$$VALKEY_PASSWORD\\" | sha256sum | cut -d ' ' -f 1); printf 'user %s on #%s %s\\\\n' default \\"$$h\\" '~* &* +@all'; printf '%s\\\\n' \\"$$OPSCREW_ACL_USERS\\" | while IFS=: read -r name access hash; do case \\"$$access\\" in read-only) rules='~* &* +@read +ping +hello +client|setname +client|setinfo -@write' ;; full) rules='~* &* +@all -@admin' ;; *) continue ;; esac; printf 'user %s on #%s %s\\\\n' \\"$$name\\" \\"$$hash\\" \\"$$rules\\"; done; } > /tmp/opscrew-users.acl && chown valkey:valkey /tmp/opscrew-users.acl; }; } && { [ -f /tmp/opscrew-password ] || (umask 077 && printf %s \\"$$VALKEY_PASSWORD\\" > /tmp/opscrew-password); } && exec docker-entrypoint.sh valkey-server --aclfile /tmp/opscrew-users.acl --appendonly yes --maxmemory 96mb --maxmemory-policy noeviction"
    environment:
      VALKEY_PASSWORD: \${OPSCREW_SVC_QUEUE_PASSWORD}
    volumes:
      - queue_data:/data
    healthcheck:
      test:
        - CMD-SHELL
        - REDISCLI_AUTH="$$(cat /tmp/opscrew-password)" valkey-cli ping | grep -q PONG
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 128m
    memswap_limit: 128m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  rabbitmq:
    image: <pin:IMAGES.rabbitmq>
    restart: unless-stopped
    hostname: rabbitmq
    environment:
      RABBITMQ_DEFAULT_USER: app
      RABBITMQ_DEFAULT_PASS: \${OPSCREW_SVC_RABBITMQ_PASSWORD}
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    configs:
      - source: rabbitmq-rabbitmq.conf
        target: /etc/rabbitmq/conf.d/90-opscrew.conf
    labels:
      dev.opscrew.config-sha256: 9217459ea18f0311c6452502c7e7d895fccb8ab6854edbf944cef6323b5a20fe
    healthcheck:
      test:
        - CMD
        - rabbitmq-diagnostics
        - -q
        - ping
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 30s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  snapshots-db:
    image: <pin:IMAGES.postgres>
    restart: unless-stopped
    user: 0:0
    environment:
      POSTGRES_USER: \${OPSCREW_DB_USER}
      POSTGRES_DB: \${OPSCREW_DB_NAME}
      POSTGRES_PASSWORD: \${OPSCREW_DB_PASSWORD}
      OPSCREW_SNAPSHOT_EVERY: "43200"
    entrypoint:
      - sh
      - -c
      - |-
        take() {
          mkdir -p "$$1" && rm -f "$$1"/db.done "$$1"/db.failed "$$1"/db.skipped || return 1
          t="$$1"/db.dump.tmp
          (umask 077 && export PGPASSWORD="$$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f "$$t" app); r=$$?
          if [ "$$r" = 0 ] && mv "$$t" "$$1"/db.dump; then
            touch "$$1"/db.done
          elif [ "$$r" = 3 ]; then
            rm -f "$$t"; touch "$$1"/db.skipped
          else
            rm -f "$$t"; touch "$$1"/db.failed
            echo 'OpsCrew: the snapshot of db failed; its output is above.' >&2
            return 1
          fi
        }
        while :; do
          now=$$(date +%s)
          slot=$$(( (now / $$OPSCREW_SNAPSHOT_EVERY + 1) * $$OPSCREW_SNAPSHOT_EVERY ))
          sleep $$(( slot - now ))
          take /snapshots/"$$(date -u -d "@$$slot" +%Y%m%dT%H%M%SZ)".partial
        done
    volumes:
      - db_data:/var/lib/postgresql/data:ro
      - snapshots:/snapshots
    depends_on:
      db:
        condition: service_healthy
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  snapshots-queue:
    image: <pin:IMAGES.valkey>
    restart: unless-stopped
    user: 0:0
    environment:
      VALKEY_PASSWORD: \${OPSCREW_SVC_QUEUE_PASSWORD}
      OPSCREW_SNAPSHOT_EVERY: "43200"
    entrypoint:
      - sh
      - -c
      - |-
        take() {
          mkdir -p "$$1" && rm -f "$$1"/queue.done "$$1"/queue.failed "$$1"/queue.skipped || return 1
          t="$$1"/queue.rdb.tmp
          (umask 077 && export REDISCLI_AUTH="$$VALKEY_PASSWORD" && valkey-cli -h queue --rdb "$$t"); r=$$?
          if [ "$$r" = 0 ] && mv "$$t" "$$1"/queue.rdb; then
            touch "$$1"/queue.done
          elif [ "$$r" = 3 ]; then
            rm -f "$$t"; touch "$$1"/queue.skipped
          else
            rm -f "$$t"; touch "$$1"/queue.failed
            echo 'OpsCrew: the snapshot of queue failed; its output is above.' >&2
            return 1
          fi
        }
        while :; do
          now=$$(date +%s)
          slot=$$(( (now / $$OPSCREW_SNAPSHOT_EVERY + 1) * $$OPSCREW_SNAPSHOT_EVERY ))
          sleep $$(( slot - now ))
          take /snapshots/"$$(date -u -d "@$$slot" +%Y%m%dT%H%M%SZ)".partial
        done
    volumes:
      - queue_data:/data:ro
      - snapshots:/snapshots
    depends_on:
      queue:
        condition: service_healthy
    mem_limit: 128m
    memswap_limit: 128m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  snapshots-sqlite:
    image: <pin:IMAGES.python>
    restart: unless-stopped
    user: 0:0
    network_mode: none
    environment:
      OPSCREW_SNAPSHOT_EVERY: "43200"
    entrypoint:
      - sh
      - -c
      - |-
        take() {
          mkdir -p "$$1" && rm -f "$$1"/sqlite.done "$$1"/sqlite.failed "$$1"/sqlite.skipped || return 1
          t="$$1"/sqlite.tar.tmp
          (umask 077 && python3 -c 'import os, sqlite3, sys, tarfile, tempfile
        d = sys.argv[1]
        s = os.stat(d)
        os.setgroups([])
        os.setgid(s.st_gid)
        os.setuid(s.st_uid)
        if not os.listdir(d):
            print("OpsCrew: the app'\\''s SQLite volume is empty, so the snapshot holds nothing of it.", file=sys.stderr)
            sys.exit(3)
        def numeric(info):
            info.uname = info.gname = ""
            return info
        def database(path):
            if os.path.islink(path) or not os.path.isfile(path):
                return False
            with open(path, "rb") as f:
                return f.read(16) == b"SQLite format 3\\x00"
        with tempfile.TemporaryDirectory() as tmp:
            copy = os.path.join(tmp, "copy")
            with tarfile.open(fileobj=sys.stdout.buffer, mode="w|", format=tarfile.GNU_FORMAT) as tar:
                for root, dirs, files in os.walk(d):
                    dirs.sort()
                    tar.add(root, os.path.relpath(root, d), recursive=False, filter=numeric)
                    for name in sorted(files):
                        path = os.path.join(root, name)
                        arcname = os.path.relpath(path, d)
                        if name.endswith(("-wal", "-shm", "-journal")):
                            continue
                        if not database(path):
                            tar.add(path, arcname, recursive=False, filter=numeric)
                            continue
                        src = sqlite3.connect("file:" + path + "?mode=rw", uri=True)
                        dst = sqlite3.connect(copy)
                        src.backup(dst)
                        src.close()
                        dst.execute("pragma journal_mode=delete")
                        dst.close()
                        info = numeric(tar.gettarinfo(path, arcname))
                        info.size = os.path.getsize(copy)
                        with open(copy, "rb") as f:
                            tar.addfile(info, f)
                        os.remove(copy)' /sqlite > "$$t"); r=$$?
          if [ "$$r" = 0 ] && mv "$$t" "$$1"/sqlite.tar; then
            touch "$$1"/sqlite.done
          elif [ "$$r" = 3 ]; then
            rm -f "$$t"; touch "$$1"/sqlite.skipped
          else
            rm -f "$$t"; touch "$$1"/sqlite.failed
            echo 'OpsCrew: the snapshot of sqlite failed; its output is above.' >&2
            return 1
          fi
        }
        while :; do
          now=$$(date +%s)
          slot=$$(( (now / $$OPSCREW_SNAPSHOT_EVERY + 1) * $$OPSCREW_SNAPSHOT_EVERY ))
          sleep $$(( slot - now ))
          take /snapshots/"$$(date -u -d "@$$slot" +%Y%m%dT%H%M%SZ)".partial
        done
    volumes:
      - sqlite:/sqlite
      - snapshots:/snapshots
    mem_limit: 128m
    memswap_limit: 128m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
  snapshots:
    image: <pin:IMAGES.busybox>
    user: 0:0
    network_mode: none
    restart: unless-stopped
    environment:
      OPSCREW_SNAPSHOT_GIVE_UP: "21600"
    entrypoint:
      - sh
      - -c
      - |-
        finish() {
          img=$$(cat /snapshots/.running 2> /dev/null)
          {
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$$2" "$$3" "$$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$\${img##*@}"
            if [ -f "$$1"/db.done ] && [ -f "$$1"/db.dump ]; then
              printf '{"name":"db","kind":"postgres","file":"db.dump","size":%s,"image":"<pin:IMAGES.postgres>"}' "$$(stat -c %s "$$1"/db.dump)"
            elif [ -f "$$1"/db.skipped ]; then
              printf '{"name":"db","kind":"postgres","skipped":true}'
            else
              printf '{"name":"db","kind":"postgres","failed":true}'
            fi
            printf ,
            if [ -f "$$1"/queue.done ] && [ -f "$$1"/queue.rdb ]; then
              printf '{"name":"queue","kind":"valkey","file":"queue.rdb","size":%s,"image":"<pin:IMAGES.valkey>"}' "$$(stat -c %s "$$1"/queue.rdb)"
            elif [ -f "$$1"/queue.skipped ]; then
              printf '{"name":"queue","kind":"valkey","skipped":true}'
            else
              printf '{"name":"queue","kind":"valkey","failed":true}'
            fi
            printf ,
            if [ -f "$$1"/sqlite.done ] && [ -f "$$1"/sqlite.tar ]; then
              printf '{"name":"sqlite","kind":"sqlite","file":"sqlite.tar","size":%s}' "$$(stat -c %s "$$1"/sqlite.tar)"
            elif [ -f "$$1"/sqlite.skipped ]; then
              printf '{"name":"sqlite","kind":"sqlite","skipped":true}'
            else
              printf '{"name":"sqlite","kind":"sqlite","failed":true}'
            fi
            printf ']}\\n'
          } > "$$1"/.about || return 1
          rm -f "$$1"/*.done "$$1"/*.failed "$$1"/*.skipped "$$1"/*.tmp
          mv "$$1"/.about "$$1"/about.json && chown -R 0:0 "$$1" && chmod 600 "$$1"/* && chmod 700 "$$1" || return 1
          rm -rf /snapshots/"$$2" && mv "$$1" /snapshots/"$$2"
        }
        prune() {
          for d in /snapshots/*; do
            case "$$d" in *.partial|*.taking) continue ;; esac
            if [ -f "$$d"/about.json ] && grep -q "\\"kind\\":\\"$$1\\"" "$$d"/about.json; then echo "$$(sed -n 's/.*"taken":"\\([^"]*\\)".*/\\1/p' "$$d"/about.json) $$d"; fi
          done | sort -r | sed "1,$$2d" | while read -r _ d; do rm -rf "$$d"; done
        }
        while :; do
          now=$$(date +%s)
          for d in /snapshots/*T*Z.partial; do
            [ -d "$$d" ] || continue
            id=$\${d##*/}; id=$\${id%.partial}
            if [ -e /snapshots/"$$id" ]; then rm -rf "$$d"; continue; fi
            start=$$(date -u -D %Y%m%dT%H%M%SZ -d "$$id" +%s) || continue
            if { [ -e "$$d"/db.done ] || [ -e "$$d"/db.failed ] || [ -e "$$d"/db.skipped ]; } && { [ -e "$$d"/queue.done ] || [ -e "$$d"/queue.failed ] || [ -e "$$d"/queue.skipped ]; } && { [ -e "$$d"/sqlite.done ] || [ -e "$$d"/sqlite.failed ] || [ -e "$$d"/sqlite.skipped ]; } || [ "$$now" -ge $$(( start + $$OPSCREW_SNAPSHOT_GIVE_UP )) ]; then
              finish "$$d" "$$id" scheduled && prune scheduled 5
            fi
          done
          sleep 10
        done
    volumes:
      - snapshots:/snapshots
    mem_limit: 16m
    memswap_limit: 16m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
  snapshot-db:
    image: <pin:IMAGES.postgres>
    restart: no
    user: 0:0
    environment:
      POSTGRES_USER: \${OPSCREW_DB_USER}
      POSTGRES_DB: \${OPSCREW_DB_NAME}
      POSTGRES_PASSWORD: \${OPSCREW_DB_PASSWORD}
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    entrypoint:
      - sh
      - -c
      - |-
        take() {
          mkdir -p "$$1" && rm -f "$$1"/db.done "$$1"/db.failed "$$1"/db.skipped || return 1
          t="$$1"/db.dump.tmp
          (umask 077 && export PGPASSWORD="$$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f "$$t" app); r=$$?
          if [ "$$r" = 0 ] && mv "$$t" "$$1"/db.dump; then
            touch "$$1"/db.done
          elif [ "$$r" = 3 ]; then
            rm -f "$$t"; touch "$$1"/db.skipped
          else
            rm -f "$$t"; touch "$$1"/db.failed
            echo 'OpsCrew: the snapshot of db failed; its output is above.' >&2
            return 1
          fi
        }
        if [ "$$OPSCREW_RELEASE" = skip ] || [ ! -f /snapshots/.running ]; then exit 0; fi
        out=$$(cat /snapshots/.running)
        if [ "$$out" = "$$OPSCREW_APP_IMAGE" ]; then exit 0; fi
        hex=$\${out##*@sha256:}
        case "$$hex" in *[!0-9a-f]*) hex= ;; esac
        if [ "$\${#hex}" -ne 64 ]; then
          echo 'OpsCrew: /snapshots/.running in the snapshots volume names no image pinned by digest, so the snapshot before this release can'\\''t be taken.' >&2
          exit 1
        fi
        take /snapshots/"$$hex".partial
    volumes:
      - db_data:/var/lib/postgresql/data:ro
      - snapshots:/snapshots
    depends_on:
      db:
        condition: service_healthy
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  snapshot-queue:
    image: <pin:IMAGES.valkey>
    restart: no
    user: 0:0
    environment:
      VALKEY_PASSWORD: \${OPSCREW_SVC_QUEUE_PASSWORD}
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    entrypoint:
      - sh
      - -c
      - |-
        take() {
          mkdir -p "$$1" && rm -f "$$1"/queue.done "$$1"/queue.failed "$$1"/queue.skipped || return 1
          t="$$1"/queue.rdb.tmp
          (umask 077 && export REDISCLI_AUTH="$$VALKEY_PASSWORD" && valkey-cli -h queue --rdb "$$t"); r=$$?
          if [ "$$r" = 0 ] && mv "$$t" "$$1"/queue.rdb; then
            touch "$$1"/queue.done
          elif [ "$$r" = 3 ]; then
            rm -f "$$t"; touch "$$1"/queue.skipped
          else
            rm -f "$$t"; touch "$$1"/queue.failed
            echo 'OpsCrew: the snapshot of queue failed; its output is above.' >&2
            return 1
          fi
        }
        if [ "$$OPSCREW_RELEASE" = skip ] || [ ! -f /snapshots/.running ]; then exit 0; fi
        out=$$(cat /snapshots/.running)
        if [ "$$out" = "$$OPSCREW_APP_IMAGE" ]; then exit 0; fi
        hex=$\${out##*@sha256:}
        case "$$hex" in *[!0-9a-f]*) hex= ;; esac
        if [ "$\${#hex}" -ne 64 ]; then
          echo 'OpsCrew: /snapshots/.running in the snapshots volume names no image pinned by digest, so the snapshot before this release can'\\''t be taken.' >&2
          exit 1
        fi
        take /snapshots/"$$hex".partial
    volumes:
      - queue_data:/data:ro
      - snapshots:/snapshots
    depends_on:
      queue:
        condition: service_healthy
    mem_limit: 128m
    memswap_limit: 128m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  snapshot-sqlite:
    image: <pin:IMAGES.python>
    restart: no
    user: 0:0
    network_mode: none
    environment:
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    entrypoint:
      - sh
      - -c
      - |-
        take() {
          mkdir -p "$$1" && rm -f "$$1"/sqlite.done "$$1"/sqlite.failed "$$1"/sqlite.skipped || return 1
          t="$$1"/sqlite.tar.tmp
          (umask 077 && python3 -c 'import os, sqlite3, sys, tarfile, tempfile
        d = sys.argv[1]
        s = os.stat(d)
        os.setgroups([])
        os.setgid(s.st_gid)
        os.setuid(s.st_uid)
        if not os.listdir(d):
            print("OpsCrew: the app'\\''s SQLite volume is empty, so the snapshot holds nothing of it.", file=sys.stderr)
            sys.exit(3)
        def numeric(info):
            info.uname = info.gname = ""
            return info
        def database(path):
            if os.path.islink(path) or not os.path.isfile(path):
                return False
            with open(path, "rb") as f:
                return f.read(16) == b"SQLite format 3\\x00"
        with tempfile.TemporaryDirectory() as tmp:
            copy = os.path.join(tmp, "copy")
            with tarfile.open(fileobj=sys.stdout.buffer, mode="w|", format=tarfile.GNU_FORMAT) as tar:
                for root, dirs, files in os.walk(d):
                    dirs.sort()
                    tar.add(root, os.path.relpath(root, d), recursive=False, filter=numeric)
                    for name in sorted(files):
                        path = os.path.join(root, name)
                        arcname = os.path.relpath(path, d)
                        if name.endswith(("-wal", "-shm", "-journal")):
                            continue
                        if not database(path):
                            tar.add(path, arcname, recursive=False, filter=numeric)
                            continue
                        src = sqlite3.connect("file:" + path + "?mode=rw", uri=True)
                        dst = sqlite3.connect(copy)
                        src.backup(dst)
                        src.close()
                        dst.execute("pragma journal_mode=delete")
                        dst.close()
                        info = numeric(tar.gettarinfo(path, arcname))
                        info.size = os.path.getsize(copy)
                        with open(copy, "rb") as f:
                            tar.addfile(info, f)
                        os.remove(copy)' /sqlite > "$$t"); r=$$?
          if [ "$$r" = 0 ] && mv "$$t" "$$1"/sqlite.tar; then
            touch "$$1"/sqlite.done
          elif [ "$$r" = 3 ]; then
            rm -f "$$t"; touch "$$1"/sqlite.skipped
          else
            rm -f "$$t"; touch "$$1"/sqlite.failed
            echo 'OpsCrew: the snapshot of sqlite failed; its output is above.' >&2
            return 1
          fi
        }
        if [ "$$OPSCREW_RELEASE" = skip ] || [ ! -f /snapshots/.running ]; then exit 0; fi
        out=$$(cat /snapshots/.running)
        if [ "$$out" = "$$OPSCREW_APP_IMAGE" ]; then exit 0; fi
        hex=$\${out##*@sha256:}
        case "$$hex" in *[!0-9a-f]*) hex= ;; esac
        if [ "$\${#hex}" -ne 64 ]; then
          echo 'OpsCrew: /snapshots/.running in the snapshots volume names no image pinned by digest, so the snapshot before this release can'\\''t be taken.' >&2
          exit 1
        fi
        take /snapshots/"$$hex".partial
    volumes:
      - sqlite:/sqlite
      - snapshots:/snapshots
    mem_limit: 128m
    memswap_limit: 128m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
  snapshot:
    image: <pin:IMAGES.busybox>
    user: 0:0
    network_mode: none
    restart: no
    environment:
      OPSCREW_RELEASE: __OPSCREW_RELEASE__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    depends_on:
      snapshot-db:
        condition: service_completed_successfully
      snapshot-queue:
        condition: service_completed_successfully
      snapshot-sqlite:
        condition: service_completed_successfully
    entrypoint:
      - sh
      - -c
      - |-
        finish() {
          img=$$(cat /snapshots/.running 2> /dev/null)
          {
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$$2" "$$3" "$$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$\${img##*@}"
            if [ -f "$$1"/db.done ] && [ -f "$$1"/db.dump ]; then
              printf '{"name":"db","kind":"postgres","file":"db.dump","size":%s,"image":"<pin:IMAGES.postgres>"}' "$$(stat -c %s "$$1"/db.dump)"
            elif [ -f "$$1"/db.skipped ]; then
              printf '{"name":"db","kind":"postgres","skipped":true}'
            else
              printf '{"name":"db","kind":"postgres","failed":true}'
            fi
            printf ,
            if [ -f "$$1"/queue.done ] && [ -f "$$1"/queue.rdb ]; then
              printf '{"name":"queue","kind":"valkey","file":"queue.rdb","size":%s,"image":"<pin:IMAGES.valkey>"}' "$$(stat -c %s "$$1"/queue.rdb)"
            elif [ -f "$$1"/queue.skipped ]; then
              printf '{"name":"queue","kind":"valkey","skipped":true}'
            else
              printf '{"name":"queue","kind":"valkey","failed":true}'
            fi
            printf ,
            if [ -f "$$1"/sqlite.done ] && [ -f "$$1"/sqlite.tar ]; then
              printf '{"name":"sqlite","kind":"sqlite","file":"sqlite.tar","size":%s}' "$$(stat -c %s "$$1"/sqlite.tar)"
            elif [ -f "$$1"/sqlite.skipped ]; then
              printf '{"name":"sqlite","kind":"sqlite","skipped":true}'
            else
              printf '{"name":"sqlite","kind":"sqlite","failed":true}'
            fi
            printf ']}\\n'
          } > "$$1"/.about || return 1
          rm -f "$$1"/*.done "$$1"/*.failed "$$1"/*.skipped "$$1"/*.tmp
          mv "$$1"/.about "$$1"/about.json && chown -R 0:0 "$$1" && chmod 600 "$$1"/* && chmod 700 "$$1" || return 1
          rm -rf /snapshots/"$$2" && mv "$$1" /snapshots/"$$2"
        }
        prune() {
          for d in /snapshots/*; do
            case "$$d" in *.partial|*.taking) continue ;; esac
            if [ -f "$$d"/about.json ] && grep -q "\\"kind\\":\\"$$1\\"" "$$d"/about.json; then echo "$$(sed -n 's/.*"taken":"\\([^"]*\\)".*/\\1/p' "$$d"/about.json) $$d"; fi
          done | sort -r | sed "1,$$2d" | while read -r _ d; do rm -rf "$$d"; done
        }
        if [ -f /snapshots/.restored ] && [ "$$(sed -n '1s/.*@//p' /snapshots/.restored)" != "$\${OPSCREW_APP_IMAGE##*@}" ]; then
          echo "OpsCrew: opscrew rollback restored this stack's data for $$(sed -n 1p /snapshots/.restored), so no other version starts on it until that rollback ends (/snapshots/.restored names it). If that rollback is stuck, run $$(sed -n 2p /snapshots/.restored) on the computer that ran it; it finishes the rollback and removes /snapshots/.restored." >&2
          exit 1
        fi
        if [ "$$OPSCREW_RELEASE" = skip ] || [ ! -f /snapshots/.running ]; then exit 0; fi
        out=$$(cat /snapshots/.running)
        if [ "$$out" = "$$OPSCREW_APP_IMAGE" ]; then exit 0; fi
        hex=$\${out##*@sha256:}
        case "$$hex" in *[!0-9a-f]*) hex= ;; esac
        if [ "$\${#hex}" -ne 64 ]; then
          echo 'OpsCrew: /snapshots/.running in the snapshots volume names no image pinned by digest, so the snapshot before this release can'\\''t be taken.' >&2
          exit 1
        fi
        finish /snapshots/"$$hex".partial "$$hex" release && prune release 3
    volumes:
      - snapshots:/snapshots
    mem_limit: 16m
    memswap_limit: 16m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
  stamp:
    image: <pin:IMAGES.curl>
    restart: no
    user: 0:0
    network_mode: none
    environment:
      OPSCREW_APP_VERSION: __OPSCREW_APP_VERSION__
      OPSCREW_APP_IMAGE: __OPSCREW_APP_IMAGE__
    entrypoint:
      - /bin/sh
      - -c
      - printf '%s\\n' "$$OPSCREW_APP_VERSION" > /version/version && printf '%s\\n' "$$OPSCREW_APP_IMAGE" > /snapshots/.running.tmp && mv /snapshots/.running.tmp /snapshots/.running
    volumes:
      - version:/version
      - snapshots:/snapshots
    depends_on:
      app:
        condition: service_started
    read_only: true
    mem_limit: 16m
    memswap_limit: 16m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  caddy:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    labels:
      dev.opscrew.caddyfile-sha256: 691a6baa89ea453dfdbb3886faa7be0167973ed80190244915cece31816d1d86
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    volumes:
      - version:/srv/opscrew-version:ro
    depends_on:
      - app
    mem_limit: 64m
    memswap_limit: 64m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  cloudflared:
    image: <pin:IMAGES.cloudflared>
    restart: unless-stopped
    command:
      - tunnel
      - --no-autoupdate
      - --metrics
      - 127.0.0.1:20241
      - run
    environment:
      TUNNEL_TOKEN: \${OPSCREW_TUNNEL_TOKEN}
    depends_on:
      - caddy
    mem_limit: 32m
    memswap_limit: 32m
    read_only: true
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
networks:
  internal: {}
volumes:
  db_data: {}
  queue_data: {}
  rabbitmq_data: {}
  sqlite: {}
  snapshots: {}
  version: {}
configs:
  caddyfile:
    content: |
      # Served through a Cloudflare Tunnel: Cloudflare terminates TLS, Caddy serves plain HTTP.
      http://shop.example.com {
      	@http_visitor header Cf-Visitor \`*"http"*\`
      	redir @http_visitor https://{host}{uri} 308
      	handle /.well-known/opscrew-version {
      		root * /srv/opscrew-version
      		rewrite * /version
      		file_server
      	}
      	encode zstd gzip
      	reverse_proxy app:3000 {
      		lb_try_duration 30s
      		lb_try_interval 250ms
      	}
      	header {
      		Strict-Transport-Security "max-age=31536000; includeSubDomains"
      		-Server
      		-X-Powered-By
      	}
      	header ?X-Content-Type-Options "nosniff"
      	header ?X-Frame-Options "SAMEORIGIN"
      	header ?Referrer-Policy "strict-origin-when-cross-origin"
      	handle_errors {
      		header {
      			Strict-Transport-Security "max-age=31536000; includeSubDomains"
      			-Server
      			-X-Powered-By
      		}
      		header ?X-Content-Type-Options "nosniff"
      		header ?X-Frame-Options "SAMEORIGIN"
      		header ?Referrer-Policy "strict-origin-when-cross-origin"
      		respond "{err.status_code} {err.status_text}" {err.status_code}
      	}
      }
  rabbitmq-rabbitmq.conf:
    content: |
      # Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
      # RabbitMQ settings for its 512 MB memory limit, loaded after the image's own.
      # The memory alarm blocks publishers well before Docker's limit would stop the node.
      vm_memory_high_watermark.absolute = 204MB
      # The default user is \`app\` (RABBITMQ_DEFAULT_USER), so RabbitMQ never creates \`guest\`; were
      # it there, it could log in only from inside the container.
      loopback_users.guest = true
"
`;
