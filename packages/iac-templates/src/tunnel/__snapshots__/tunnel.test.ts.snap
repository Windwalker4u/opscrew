// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`runtime files in tunnel mode > serves plain HTTP for the domain (Cloudflare terminates TLS) and keeps HSTS 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# shop's site on the server's shared edge: the deploy copies it to /srv/edge/sites.
# Served through a Cloudflare Tunnel: Cloudflare terminates TLS, Caddy serves plain HTTP.
http://example.com {
	@http_visitor header Cf-Visitor \`*"http"*\`
	redir @http_visitor https://{host}{uri} 308
	encode zstd gzip
	reverse_proxy kamal-proxy:80
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-X-Powered-By
	}
	header ?X-Content-Type-Options "nosniff"
	header ?X-Frame-Options "SAMEORIGIN"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	handle_errors {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			-Server
			-X-Powered-By
		}
		header ?X-Content-Type-Options "nosniff"
		header ?X-Frame-Options "SAMEORIGIN"
		header ?Referrer-Policy "strict-origin-when-cross-origin"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

http://www.example.com {
	redir https://example.com{uri} 308
}
"
`;
